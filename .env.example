# Local development template. Copy to .env and fill in your own values.
# Never commit .env — it is ignored by git.

# SQLite for local development. Use a postgresql:// URL in production.
DATABASE_URL="file:./dev.db"

# Required: free key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: background scrape queue (BullMQ + Redis)
REDIS_URL="redis://localhost:6379"
SCRAPE_QUEUE_ENABLED="false"

# Optional: outbound proxies for scraping, comma separated (http://user:pass@host:port)
OUTBOUND_PROXY_MODE="optional"
OUTBOUND_PROXY_URLS=""
OUTBOUND_PROXY_ROTATION="round_robin"

# Optional: key that is always accepted by the REST API (keep it secret)
BADROCK_MASTER_KEY=""

# Optional: private media resolver (Google Drive / OneDrive)
PRIVATE_MEDIA_RESOLVER_URL="http://localhost:3091"
