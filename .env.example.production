APP_DOMAIN=example.com
NEXT_PUBLIC_APP_URL=https://example.com

POSTGRES_USER=bandrackply
POSTGRES_PASSWORD=change-this-long-random-password
POSTGRES_DB=bandrackply
DATABASE_URL=postgresql://bandrackply:change-this-long-random-password@postgres:5432/bandrackply

REDIS_URL=redis://redis:6379
SCRAPE_QUEUE_ENABLED=true
SCRAPE_WORKER_CONCURRENCY=2
# Keep false on a basic VPS: Bandrackply resolves and validates sources, but does not retransmit video bytes.
ALLOW_VPS_VIDEO_PROXY=false

TMDB_API_KEY=replace-with-your-tmdb-key

# Pelis Juanita catalog. Protect this header with a Cloudflare WAF skip rule
# limited to the catalog/search paths used by Bandrackply.
PELISJUANITA_BASE_URL=https://pelisjuanita.com
PELISJUANITA_API_TOKEN=replace-with-a-long-random-token

OUTBOUND_PROXY_MODE=optional
# Add one or more HTTP/HTTPS proxies separated by commas.
# Example: OUTBOUND_PROXY_URLS=http://user:pass@host1:port,http://user:pass@host2:port
OUTBOUND_PROXY_URLS=
OUTBOUND_PROXY_ROTATION=round_robin

DEBUG_LOGS=false
